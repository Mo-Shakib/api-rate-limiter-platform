# App
ENV=local
APP_NAME=rate-limit-platform
APP_SECRET=change-me-to-a-long-random-string

# Server
HOST=0.0.0.0
PORT=8000

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rate_limit_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy URL (for local running outside docker)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rate_limit_db

# Redis
REDIS_URL=redis://localhost:6379/0
